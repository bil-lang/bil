package main

import "time"

const total = 5

proc highSender(high chan<- int) {
	for i := range total {
		high <- i
	}
}

proc lowSender(low chan<- int) {
	for i := range total {
		low <- i
	}
}

proc server(high <-chan int, low <-chan int) {
	for range 2 * total {
		time.Sleep(5 * time.Millisecond)
		pri alt {
			high -> _ {
				println("high")
			}
			low -> _ {
				println("low")
			}
		}
	}
}

func main() {
	high := make(chan int)
	low := make(chan int)
	
	par {
		server(high, low)
		highSender(high)
		lowSender(low)
	}
}
