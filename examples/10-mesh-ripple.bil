//
// A real Bil program running on the WASM-worker grid emulator
// (../../emulator, a sibling repo — see its README and
// STRATEGY.md's "Emulator architecture" note): a counter ripples
// east along each row, reflects at the last column, and ripples
// back west.
//
// Three roles, placed by column position and wildcarded across every
// row: `origin` at column 0, `reflect` at the last column, `relay`
// everywhere else. Row never matters here (the ripple is identical,
// independent, on every row), so every clause below wildcards it with
// `*` -- `processor(*, 0)`, `processor(*, cols-1)`, `processor(*, *)`
// -- rather than naming a single row. This mirrors
// ../../emulator/nodeprog/ripple/main.go, the hand-written Go version
// of this same demo built during the emulator's Phase A, now running
// as real compiled Bil instead, and it's the direct ancestor of
// Example 20 (placed-controller)'s own controller/rowEnd/relay split
// -- same three-role shape, generalized here to run identically on
// every row instead of just row 0.
//
// `place NAME at link[EXPR].in`/`.out` lives in the `placed par` clause
// that calls a role's proc, not inside the proc's own body -- it binds
// one of that role's declared, typed channel parameters (`chan<-
// int` for a send-only direction, `<-chan int` for receive-only)
// to a physical link. The `.in`/`.out` suffix says which half of that
// link this is, right next to the index itself, purely for a reader's
// sake -- link[1] is east and link[3] is west below (a convention
// owned by the emulator's topology layer, ../../emulator/cmd/wasm/static/index.html's
// buildTopology, not by bilc or bilink; a different topology would
// number its links differently), so `link[1].out` reads as "send
// east" and `link[3].in` as "receive from west" without needing to
// remember the mapping by heart.

package main

import "time"

const waves = 3

// hopDelay is purely cosmetic -- the rendezvous itself already
// enforces correct pacing (both sides must be present), this just
// makes the ripple visible to a human watching the grid rather than
// resolving instantly.
const hopDelay = 150 * time.Millisecond

// origin runs at column 0 of every row: originates each wave east,
// then awaits its reflection back on the same physical link.
proc origin(eastOut chan<- int, eastIn <-chan int) {
	r := bilink.Row()
	bilink.Screenf("(%d,0) ready", r)

	if bilink.NumCols() < 2 {
		bilink.Screenf("(%d,0) single column, nothing to ripple", r)
		stop
	}

	for wave := range waves {
		time.Sleep(hopDelay)
		bilink.Screenf("wave %d: send east = %d", wave, wave)
		eastOut <- wave
		var v int
		eastIn -> v
		bilink.Screenf("wave %d: reflected back = %d", wave, v)
	}

	bilink.Screenf("(%d,0) done, %d waves complete", r, waves)
	stop
}

// reflect runs at the last column of every row: receives each wave
// from the west, then reflects it straight back.
proc reflect(westIn <-chan int, westOut chan<- int) {
	r, c := bilink.Row(), bilink.Col()
	bilink.Screenf("(%d,%d) ready", r, c)

	for wave := range waves {
		var v int
		westIn -> v
		bilink.Screenf("wave %d: got %d, reflecting", wave, v)
		time.Sleep(hopDelay)
		westOut <- v
	}

	bilink.Screenf("(%d,%d) done, %d waves complete", r, c, waves)
	stop
}

// relay runs everywhere else: forwards each wave east, then forwards
// its reflection back west.
proc relay(westIn <-chan int, eastOut chan<- int, eastIn <-chan int, westOut chan<- int) {
	r, c := bilink.Row(), bilink.Col()
	bilink.Screenf("(%d,%d) ready", r, c)

	for wave := range waves {
		var v int
		westIn -> v
		bilink.Screenf("wave %d: got %d, forward east", wave, v)
		time.Sleep(hopDelay)
		eastOut <- v

		var v2 int
		eastIn -> v2
		bilink.Screenf("wave %d: reflection %d, forward west", wave, v2)
		time.Sleep(hopDelay)
		westOut <- v2
	}

	bilink.Screenf("(%d,%d) done, %d waves complete", r, c, waves)
	stop
}

func main() {
	cols := bilink.NumCols()

	placed par {
		processor(*, 0) {
			place eastOut at link[1].out
			place eastIn at link[1].in
			origin(eastOut, eastIn)
		}
		processor(*, cols-1) {
			place westIn at link[3].in
			place westOut at link[3].out
			reflect(westIn, westOut)
		}
		processor(*, *) {
			place westIn at link[3].in
			place eastOut at link[1].out
			place eastIn at link[1].in
			place westOut at link[3].out
			relay(westIn, eastOut, eastIn, westOut)
		}
	}
}
