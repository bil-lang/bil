//
// A heterogeneous placement demo on the WASM-worker grid emulator
// (../../emulator, a sibling repo — see its README and
// STRATEGY.md's "Emulator architecture" note), building on Example 19
// (mesh-ripple): that example runs the *same* proc on every node,
// branching internally on its own position. `placed par` instead lets
// this program give genuinely different, separately-named roles to
// specific processors — `controller` at (0,0), `rowEnd` at
// (0,cols-1), `relay` for the rest of row 0, `idle` everywhere else —
// each its own proc, reasoned about on its own, with the placement
// itself as the only new machinery: the send/receive pattern is
// exactly Example 19's already-verified one.
//
// `place NAME at link[EXPR]` now lives in the `placed par` clause that
// *calls* a proc, not inside the proc's own body: it binds one of the
// callee's own declared channel parameters to a physical link, rather
// than inventing a brand-new name. `controller`/`rowEnd`/`relay` below
// are ordinary chan/proc Bil — no `place`/`link` anywhere in them —
// exactly the shape Example 01/02 already use, and could in principle
// be developed and tested with real `make(chan int32)` wiring before
// ever being placed at all. `place` only appears in `main()`, where
// each clause wires the proc it calls onto specific links. A `chan T`
// parameter used bidirectionally by one proc (send then receive on the
// same physical link, as the old design's `toEast`/`toWest` aliases
// did) becomes two separate directional parameters here instead
// (`chan<- int32` / `<-chan int32`), each `place`d onto the *same*
// link index — a real Go channel can't be used for both directions in
// one proc (see checkProcChanBothDirections), so one physical,
// bidirectional link is now two Go-level channels sharing an index.
// A proc's non-channel parameters must be genuine compile-time
// constants at every placed call site — a proc needing runtime
// information (grid size, its own position) calls
// bilink.Row()/Col()/NumCols() etc. directly, itself, rather than
// receiving it as a parameter; `controller` below is the concrete
// example (it used to take `cols int` as a parameter).

package main

import "time"

const rounds = 3
const hopDelay = 150 * time.Millisecond

// controller runs at exactly one processor, (0,0): originates each
// round's value east on toEast, then waits for it to come back
// reflected on fromEast.
proc controller(toEast chan<- int32, fromEast <-chan int32) {
	cols := bilink.NumCols()
	bilink.Screenf("controller ready, %d cols", cols)
	for round := 0; round < rounds; round++ {
		time.Sleep(hopDelay)
		toEast <- int32(round)
		var v int32
		fromEast -> v
		bilink.Screenf("round %d: reflected %d", round, v)
	}
	bilink.Screenf("controller done")
	stop
}

// rowEnd runs at (0,cols-1): the far end of row 0, receiving from the
// west and reflecting straight back west.
proc rowEnd(fromWest <-chan int32, toWest chan<- int32) {
	bilink.Screenf("row-end ready")
	for round := 0; round < rounds; round++ {
		var v int32
		fromWest -> v
		bilink.Screenf("round %d: got %d, reflecting", round, v)
		time.Sleep(hopDelay)
		toWest <- v
	}
	bilink.Screenf("row-end done")
	stop
}

// relay runs on every other row-0 processor: forward east, forward
// the reflection back west. Both the west and east links are used
// bidirectionally, so each gets two directional parameters.
proc relay(fromWestIn <-chan int32, toEastOut chan<- int32, toEastIn <-chan int32, fromWestOut chan<- int32) {
	bilink.Screenf("relay ready")
	for round := 0; round < rounds; round++ {
		var v int32
		fromWestIn -> v
		toEastOut <- v
		var v2 int32
		toEastIn -> v2
		fromWestOut <- v2
	}
	bilink.Screenf("relay done")
	stop
}

// idle runs everywhere off row 0 — nothing to do in this demo, just
// confirming placement dispatched here correctly at all.
proc idle() {
	bilink.Screenf("idle -- not part of row 0")
	stop
}

func main() {
	r, cols := bilink.Row(), bilink.NumCols()

	placed par {
		processor(0, 0) {
			place toEast at link[1]
			place fromEast at link[1]
			controller(toEast, fromEast)
		}
		processor(0, cols-1) {
			place fromWest at link[3]
			place toWest at link[3]
			rowEnd(fromWest, toWest)
		}
		default {
			if r == 0 {
				place fromWestIn at link[3]
				place toEastOut at link[1]
				place toEastIn at link[1]
				place fromWestOut at link[3]
				relay(fromWestIn, toEastOut, toEastIn, fromWestOut)
			} else {
				idle()
			}
		}
	}
}
