//
// A heterogeneous placement demo on the WASM-worker grid emulator
// (../../emulator, a sibling repo — see its README and
// STRATEGY.md's "Emulator architecture" note), building on Example 10
// (mesh-ripple)'s own origin/reflect/relay split: this one narrows the
// same three roles to just row 0 (`controller` at (0,0), `rowEnd` at
// (0,cols-1), `relay` for the rest of that row) and adds a fourth,
// `idle`, for every row off row 0 — the send/receive pattern in each
// is exactly Example 10's already-verified one.
//
// `place NAME at link[EXPR].in`/`.out` lives in the `placed par` clause
// that *calls* a proc, not inside the proc's own body: it binds one of
// the callee's own declared channel parameters to a physical link,
// rather than inventing a brand-new name. `controller`/`rowEnd`/`relay`
// below are ordinary chan/proc Bil — no `place`/`link` anywhere in
// them — exactly the shape Example 01/02 already use, and could in
// principle be developed and tested with real `make(chan int)`
// wiring before ever being placed at all. `place` only appears in
// `main()`, where each clause wires the proc it calls onto specific
// links, and the `.in`/`.out` suffix says which half of that physical
// link this is, right next to the index itself. A `chan T` parameter
// used bidirectionally by one proc (send then receive on the same
// physical link) becomes two separate directional parameters here
// instead (`chan<- int` / `<-chan int`), each `place`d onto the
// *same* link index but opposite suffix — a real Go channel can't be
// used for both directions in one proc (see
// checkProcChanBothDirections), so one physical, bidirectional link is
// now two Go-level channels sharing an index. A proc's non-channel
// parameters must be genuine compile-time constants at every placed
// call site — a proc needing runtime information (grid size, its own
// position) calls bilink.Row()/Col()/NumCols() etc. directly, itself,
// rather than receiving it as a parameter.

package main

import "time"

const rounds = 3
const hopDelay = 150 * time.Millisecond

// controller runs at exactly one processor, (0,0): originates each
// round's value east, then waits for it to come back reflected.
proc controller(eastOut chan<- int, eastIn <-chan int) {
	cols := bilink.NumCols()
	bilink.Screenf("controller ready, %d cols", cols)
	for round := range rounds {
		time.Sleep(hopDelay)
		eastOut <- round
		var v int
		eastIn -> v
		bilink.Screenf("round %d: reflected %d", round, v)
	}
	bilink.Screenf("controller done")
	stop
}

// rowEnd runs at (0,cols-1): the far end of row 0, receiving from the
// west and reflecting straight back west.
proc rowEnd(westIn <-chan int, westOut chan<- int) {
	bilink.Screenf("row-end ready")
	for round := range rounds {
		var v int
		westIn -> v
		bilink.Screenf("round %d: got %d, reflecting", round, v)
		time.Sleep(hopDelay)
		westOut <- v
	}
	bilink.Screenf("row-end done")
	stop
}

// relay runs on every other row-0 processor: forward east, forward
// the reflection back west. Both the west and east links are used
// bidirectionally, so each gets two directional parameters.
proc relay(westIn <-chan int, eastOut chan<- int, eastIn <-chan int, westOut chan<- int) {
	bilink.Screenf("relay ready")
	for range rounds {
		var v int
		westIn -> v
		eastOut <- v
		var v2 int
		eastIn -> v2
		westOut <- v2
	}
	bilink.Screenf("relay done")
	stop
}

// idle runs everywhere off row 0 — nothing to do in this demo, just
// confirming placement dispatched here correctly at all.
proc idle() {
	bilink.Screenf("idle -- not part of row 0")
	stop
}

func main() {
	cols := bilink.NumCols()

	placed par {
		processor(0, 0) {
			place eastOut at link[1].out
			place eastIn at link[1].in
			controller(eastOut, eastIn)
		}
		processor(0, cols-1) {
			place westIn at link[3].in
			place westOut at link[3].out
			rowEnd(westIn, westOut)
		}
		processor(0, *) {
			place westIn at link[3].in
			place eastOut at link[1].out
			place eastIn at link[1].in
			place westOut at link[3].out
			relay(westIn, eastOut, eastIn, westOut)
		}
		processor(*, *) {
			idle()
		}
	}
}
