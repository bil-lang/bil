package main

import "time"

proc server(request <-chan int, shutdown <-chan bool) {
	var x int
	var sd bool

	for {
		alt {
			request -> x {
				println(x)
			}
			time -> After(1 * time.Second) {
				println("tick")
			}
			shutdown -> sd {
				if sd {
					return
				}
			}
		}
	}
}

func main() {
	request  := make(chan int)
	shutdown := make(chan bool)

	par {
		server(request, shutdown)
		seq {
			request <- 1
			request <- 2
			time.Sleep(3 * time.Second)
			request <- 3
			shutdown <- true
		}
	}
}
