package main

type Shape interface{ isShape() }

type Circle struct{ Radius int }

func (Circle) isShape() {}

type Square struct{ Side int }

func (Square) isShape() {}

proc describer(shapes <-chan Shape) {
	for range 2 {
		shapes -> case s {
			Circle {
				println("circle", s.Radius)
			}
			Square {
				println("square", s.Side)
			}
		}
	}
}

func main() {
	shapes := make(chan Shape)
	par {
		describer(shapes)
		seq {
			shapes <- Circle{Radius: 3}
			shapes <- Square{Side: 4}
		}
	}
}
