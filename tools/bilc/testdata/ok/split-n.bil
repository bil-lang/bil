package main

proc worker(chunk []int, out chan<- int) {
	sum := 0
	for _, v := range chunk {
		sum += v
	}
	out <- sum
}

func main() {
	data := []int{1, 2, 3, 4, 5, 6, 7}
	chunks := splitN(data, 3)
	sums := makeChans[int](3)

	par {
		par i := range 3 {
			worker(chunks[i], sums[i])
		}
		seq {
			total := 0
			for i := range 3 {
				var s int
				sums[i] -> s
				total += s
			}
			println(total)
		}
	}
}
