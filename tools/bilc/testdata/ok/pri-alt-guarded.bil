package main

proc chooser(a <-chan int, b <-chan int, allowA bool) {
	var v int
	for range 2 {
		pri alt {
			(allowA) && a -> v {
				println("a", v)
			}
			b -> v {
				println("b", v)
			}
		}
	}
}

func main() {
	a := make(chan int)
	b := make(chan int)
	par {
		chooser(a, b, false)
		seq {
			b <- 1
			b <- 2
		}
	}
}
