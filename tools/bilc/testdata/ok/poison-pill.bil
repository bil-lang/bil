package main

const n = 10
const limit = 30
const done = 0

proc generator(out chan<- int) {
	for v := 2; v <= limit; v++ {
		out <- v
	}
	out <- done
}

proc filter(in <-chan int, out chan<- int) {
	var prime, v int
	in -> prime
	println(prime)
	for {
		in -> v
		if v == done {
			out <- done
			return
		}
		if v%prime != 0 {
			out <- v
		}
	}
}

proc sink(in <-chan int) {
	var v int
	for {
		in -> v
		if v == done {
			return
		}
	}
}

func main() {
	c := makeChans[int](n + 1)
	par {
		generator(c[0])
		par i := range n {
			filter(c[i], c[i+1])
		}
		sink(c[n])
	}
}
